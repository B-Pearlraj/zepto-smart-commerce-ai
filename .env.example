# Copy to .env for LOCAL testing only. On Render, set these in
# Dashboard -> your service -> Environment. Never commit the real .env.

# Neon: Dashboard -> Connect -> copy the connection string (pooled is fine)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Pick a long, unique password. SECRET_KEY: any random 48+ character string.
ADMIN_PASSWORD=
SECRET_KEY=

# Your portfolio site(s), comma separated, no trailing slash or path
ALLOWED_ORIGINS=https://your-portfolio.onrender.com,http://localhost:5500

# Shown to the model so it knows whose portfolio this is
OWNER_NAME=Muthuraj B

# Optional tuning (defaults shown)
# GEMINI_CHAT_MODEL=gemini-2.5-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001
# MIN_SCORE=0.40
# TOP_K=5
# MAX_UPLOAD_MB=10
# CHAT_RATE_PER_MIN=10
# CHAT_RATE_PER_DAY=100
# CHAT_GLOBAL_PER_DAY=600
# COOKIE_SECURE=false   # only when testing on http://localhost
